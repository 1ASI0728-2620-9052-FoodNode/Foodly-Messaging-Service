# Referencia: Spring Boot no lee este archivo. Cópielo a .env (ignorado por Git) y complete los secretos:
# Docker Compose lo lee solo; para ./mvnw spring-boot:run exporte las variables en su terminal.
# Nunca ponga valores reales aquí.

# --- JWT de IAM (obligatoria, sin valor por defecto) ---
# La MISMA clave que usa IAM como JWT_SECRET_BASE64: Base64 estándar, se decodifica a bytes (mínimo 32).
# Genere una con:  openssl rand -base64 32
JWT_SECRET_BASE64=
# iss exacto y aud que debe incluir este valor. Coinciden con los valores por defecto de IAM.
JWT_ISSUER=foodly-iam
JWT_AUDIENCE=foodly-messaging
# Nombres de los claims (opcional)
# JWT_USER_ID_CLAIM=sub
# JWT_ROLE_CLAIM=role
# IMPORTANTE: Messaging reenvía el token del explorador a Business, Radar y Reservation. IAM debe emitir en aud
# (JWT_AUDIENCES de IAM) foodly-messaging, foodly-business, foodly-radar y foodly-reservation. Con los valores por
# defecto de IAM ya están todos.

# --- Base de datos (MySQL) ---
MYSQL_URL=jdbc:mysql://localhost:3307/messaging?allowPublicKeyRetrieval=true
MYSQL_USER=messaging
MYSQL_PASSWORD=
MYSQL_SSL_MODE=DISABLED

# --- Callback de Lía ---
INTEGRATION_CALLBACK_SECRET=

# --- Otros servicios (perfil local; el compose define sus propias URLs) ---
# Mapa de puertos: Business 8080, IAM 8081, Radar 8082, Messaging 8083, Reservation 8084.
RADAR_URL=http://localhost:8082
BUSINESS_URL=http://localhost:8080
RESERVATION_URL=http://localhost:8084

# --- Servidor ---
SERVER_PORT=8083
MESSAGING_HOST_PORT=8083
